// Based on https://learnopengl.com/PBR/Theory

#ifdef GL_ES
precision highp float;
#endif

layout(push_constant, std430) uniform DrawCall {
  uint material_index;
}
draw_call;

layout(set = 1, binding = 0, std140) uniform SceneData {
  mat4 view_projection;
  vec3 cam_pos;
}
scene_data;

struct LightData {
  vec3 pos;
  float power;
};

layout(set = 1, binding = 1, std140) uniform Lights {
  LightData data[4];
}
lights;

struct MaterialData {
  vec3 albedo;
  float metallic;
  float roughness;
  float ao;
};

layout(set = 2, binding = 0, std430) buffer restrict readonly Materials {
  MaterialData data[];
}
materials;

layout(set = 2, binding = 1) uniform sampler2D albedo_map[32];
layout(set = 2, binding = 2) uniform sampler2D normal_map[32];
layout(set = 2, binding = 3) uniform sampler2D metallic_map[32];
layout(set = 2, binding = 4) uniform sampler2D roughness_map[32];
layout(set = 2, binding = 5) uniform sampler2D height_map[32];

layout(location = 0) in vec3 world_pos;
layout(location = 1) in vec3 normal;
layout(location = 2) in vec3 tangent;
layout(location = 3) in vec2 tex_coord;

layout(location = 0) out vec4 frag_color;

const float PI = 3.14159265359;

vec2 ParallaxMapping(vec2 texCoords, vec3 viewDir, uint matIdx) {
  float heightScale = 0.02;  // tweak this for stronger/weaker displacement
  float height = texture(height_map[matIdx], texCoords).r;
  return texCoords - viewDir.xy * (height * heightScale);
}

vec2 SteepParallaxMapping(vec2 texCoords, vec3 viewDirTS, uint matIdx) {
  // Number of depth layers (quality/performance trade-off)
  const float minLayers = 8.0;
  const float maxLayers = 32.0;

  // More layers for shallow view angles (better quality at grazing angles)
  float numLayers = mix(maxLayers, minLayers, abs(viewDirTS.z));

  // Calculate the size of each depth layer
  float layerDepth = 1.0 / numLayers;

  // Amount to shift texture coordinates per layer
  float heightScale = 0.05;  // tweak for stronger/weaker displacement
  vec2 P = viewDirTS.xy * heightScale;
  vec2 deltaTexCoords = P / numLayers;

  // Current depth and texcoord
  float currentLayerDepth = 0.0;
  vec2 currentTexCoords = texCoords;

  // Depth from height map at current texcoords
  float currentDepthMapValue = texture(height_map[matIdx], currentTexCoords).r;

  // Step through layers until we pass the depth
  while (currentLayerDepth < currentDepthMapValue) {
    currentTexCoords -= deltaTexCoords;
    currentLayerDepth += layerDepth;
    currentDepthMapValue = texture(height_map[matIdx], currentTexCoords).r;
  }

  return currentTexCoords;
}

vec2 ParallaxOcclusionMapping(vec2 texCoords, vec3 viewDirTS, uint matIdx) {
  // Number of depth layers (quality/performance trade-off)
  const float minLayers = 8.0;
  const float maxLayers = 32.0;

  // More layers for shallow view angles (better quality at grazing angles)
  float numLayers = mix(maxLayers, minLayers, abs(viewDirTS.z));

  // Size of each depth layer
  float layerDepth = 1.0 / numLayers;

  // Shift in texture coordinates per layer
  float heightScale = 0.05;  // tweak for stronger/weaker displacement
  vec2 P = viewDirTS.xy * heightScale;
  vec2 deltaTexCoords = P / numLayers;

  // Current depth and texcoord
  float currentLayerDepth = 0.0;
  vec2 currentTexCoords = texCoords;

  // Depth from height map at current texcoords
  float currentDepthMapValue = texture(height_map[matIdx], currentTexCoords).r;

  // Previous values for interpolation
  float prevLayerDepth = 0.0;
  vec2 prevTexCoords = texCoords;

  // Step through layers
  while (currentLayerDepth < currentDepthMapValue) {
    prevTexCoords = currentTexCoords;
    prevLayerDepth = currentLayerDepth;

    currentTexCoords -= deltaTexCoords;
    currentLayerDepth += layerDepth;
    currentDepthMapValue = texture(height_map[matIdx], currentTexCoords).r;
  }

  // --- Parallax Occlusion Mapping interpolation ---
  float afterDepth = currentDepthMapValue - currentLayerDepth;
  float beforeDepth =
      texture(height_map[matIdx], prevTexCoords).r - prevLayerDepth;
  float weight = beforeDepth / (beforeDepth - afterDepth);

  return mix(currentTexCoords, prevTexCoords, clamp(weight, 0.0, 1.0));
}

float DistributionGGX(vec3 N, vec3 H, float roughness) {
  float a = roughness * roughness;
  float a2 = a * a;
  float NdotH = max(dot(N, H), 0.0);
  float NdotH2 = NdotH * NdotH;

  float nom = a2;
  float denom = (NdotH2 * (a2 - 1.0) + 1.0);
  denom = PI * denom * denom;

  return nom / denom;
}

float GeometrySchlickGGX(float NdotV, float roughness) {
  float r = (roughness + 1.0);
  float k = (r * r) / 8.0;

  float nom = NdotV;
  float denom = NdotV * (1.0 - k) + k;

  return nom / denom;
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
  float NdotV = max(dot(N, V), 0.0);
  float NdotL = max(dot(N, L), 0.0);
  float ggx2 = GeometrySchlickGGX(NdotV, roughness);
  float ggx1 = GeometrySchlickGGX(NdotL, roughness);

  return ggx1 * ggx2;
}

vec3 FresnelSchlick(float cosTheta, vec3 F0) {
  return F0 + (1.0 - F0) * pow(1.0 - cosTheta, 5.0);
}

void main() {
  uint mat_ind = draw_call.material_index;

  // Build TBN
  vec3 N = normalize(normal);
  vec3 T = normalize(tangent);
  vec3 B = normalize(cross(N, T));
  mat3 TBN = mat3(T, B, N);

  vec3 V = normalize(scene_data.cam_pos - world_pos);
  vec3 viewDirTS = normalize(TBN * V);

  // Parallax mapping to get displaced UVs
  vec2 texCoords = ParallaxOcclusionMapping(tex_coord, viewDirTS, mat_ind);

  MaterialData material;

  material.albedo = pow(texture(albedo_map[mat_ind], texCoords).rgb, vec3(2.2));
  material.metallic = texture(metallic_map[mat_ind], texCoords).r;
  material.roughness = texture(roughness_map[mat_ind], texCoords).r;
  material.ao = materials.data[mat_ind].ao;

  vec3 tangent_normal = texture(normal_map[mat_ind], texCoords).xyz * 2.0 - 1.0;
  N = normalize(TBN * tangent_normal);

  // calculate reflectance at normal incidence; if dia-electric (like plastic)
  // use F0 of 0.04 and if it's a metal, use the albedo color as F0 (metallic
  // workflow)
  vec3 F0 = vec3(0.04);
  F0 = mix(F0, material.albedo, material.metallic);

  // reflectance equation
  vec3 Lo = vec3(0.0);
  for (int i = 0; i < 4; ++i) {
    // calculate per-light radiance
    vec3 L = normalize(lights.data[i].pos - world_pos);
    vec3 H = normalize(V + L);
    float distance = length(lights.data[i].pos - world_pos);
    float attenuation = 1.0 / (distance * distance);
    vec3 radiance = vec3(lights.data[i].power) * attenuation;

    // Cook-Torrance BRDF
    float NDF = DistributionGGX(N, H, material.roughness);
    float G = GeometrySmith(N, V, L, material.roughness);
    vec3 F = FresnelSchlick(max(dot(H, V), 0.0), F0);

    vec3 numerator = NDF * G * F;
    float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) +
                        0.0001;  // + 0.0001 to prevent divide by zero
    vec3 brdf = numerator / denominator;

    // kS is equal to Fresnel
    vec3 kS = F;
    // for energy conservation, the diffuse and specular light can't
    // be above 1.0 (unless the surface emits light); to preserve this
    // relationship the diffuse component (kD) should equal 1.0 - kS.
    vec3 kD = vec3(1.0) - kS;
    // multiply kD by the inverse metalness such that only non-metals
    // have diffuse lighting, or a linear blend if partly metal (pure metals
    // have no diffuse light).
    kD *= 1.0 - material.metallic;

    // scale light by NdotL
    float NdotL = max(dot(N, L), 0.0);

    // add to outgoing radiance Lo
    Lo += (kD * material.albedo / PI + brdf) * radiance *
          NdotL;  // note that we already multiplied the BRDF by the Fresnel
                  // (kS) so we won't multiply by kS again
  }

  // ambient lighting
  vec3 ambient = vec3(0.03) * material.albedo * material.ao;
  vec3 color = ambient + Lo;

  // HDR tonemapping
  color = color / (color + vec3(1.0));
  // gamma correct
  color = pow(color, vec3(1.0 / 2.2));

  frag_color = vec4(color, 1.0);
}
