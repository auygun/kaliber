// Based on https://learnopengl.com/PBR/Theory

#ifdef GL_ES
precision highp float;
#endif

layout(push_constant, std430) uniform DrawCall {
  uint material_index;
  bool is_material;
  bool dir_light;
}
draw_call;

layout(set = 1, binding = 0, std140) uniform SceneData {
  mat4 view_projection;
  vec3 cam_pos;
  float white;
  vec3 dir_light_direction;
  float exposure;
  vec3 dir_light_radiance;
}
scene_data;

struct LightData {
  vec3 pos;
  float power;
};

layout(set = 1, binding = 1, std140) uniform Lights {
  LightData data[4];
}
lights;

struct MaterialData {
  vec3 albedo;
  float metallic;
  float roughness;
  float ao;
};

layout(set = 2, binding = 0, std430) buffer restrict readonly Materials {
  MaterialData data[];
}
materials;

layout(set = 2, binding = 1) uniform sampler2D albedo_map;
layout(set = 2, binding = 2) uniform sampler2D normal_map;
layout(set = 2, binding = 3) uniform sampler2D metallic_map;
layout(set = 2, binding = 4) uniform sampler2D roughness_map;

layout(location = 0) in vec3 world_pos;
layout(location = 1) in vec3 normal;
layout(location = 2) in vec3 tangent;
layout(location = 3) in vec2 tex_coord;

layout(location = 0) out vec4 frag_color;

const float PI = 3.14159265359;

vec3 TonemapFilmic(vec3 color, float white) {
  // Bias baked into constants for performance. Useful to scale the input to the
  // range that the tonemapper is designed for. It has no effect on the curve's
  // general shape or visual properties
  const float exposure_bias = 2.0f;
  const float A = 0.22f * exposure_bias * exposure_bias;
  const float B = 0.30f * exposure_bias;
  const float C = 0.10f;
  const float D = 0.20f;
  const float E = 0.01f;
  const float F = 0.30f;

  vec3 color_tonemapped = ((color * (A * color + C * B) + D * E) /
                           (color * (A * color + B) + D * F)) -
                          E / F;
  float white_tonemapped = ((white * (A * white + C * B) + D * E) /
                            (white * (A * white + B) + D * F)) -
                           E / F;

  return color_tonemapped / white_tonemapped;
}

// This expects 0-1 range input.
vec3 Linear2SRGB(vec3 color) {
#if OFFICIAL_SRGB_TRANSFORMATION
  return mix(vec3(1.055f) * pow(color.rgb, vec3(1.0f / 2.4f)) - vec3(0.055f),
             12.92f * color.rgb, lessThan(color.rgb, vec3(0.0031308f)));
#else
  // Approximation from
  // http://chilliant.blogspot.com/2012/08/srgb-approximations-for-hlsl.html
  return max(vec3(1.055) * pow(color, vec3(0.416666667)) - vec3(0.055),
             vec3(0.0));
#endif
}

float DistributionGGX(vec3 N, vec3 H, float roughness) {
  float a = roughness * roughness;
  float a2 = a * a;
  float NdotH = max(dot(N, H), 0.0);
  float NdotH2 = NdotH * NdotH;

  float nom = a2;
  float denom = (NdotH2 * (a2 - 1.0) + 1.0);
  denom = PI * denom * denom;

  return nom / denom;
}

float GeometrySchlickGGX(float NdotV, float roughness) {
  float r = (roughness + 1.0);
  float k = (r * r) / 8.0;

  float nom = NdotV;
  float denom = NdotV * (1.0 - k) + k;

  return nom / denom;
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness) {
  float NdotV = max(dot(N, V), 0.0);
  float NdotL = max(dot(N, L), 0.0);
  float ggx2 = GeometrySchlickGGX(NdotV, roughness);
  float ggx1 = GeometrySchlickGGX(NdotL, roughness);

  return ggx1 * ggx2;
}

vec3 FresnelSchlick(float cosTheta, vec3 F0) {
  return F0 + (1.0 - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

// Helper function to calculate the core PBR BRDF terms.
vec3 PBR_Contribution(vec3 L, vec3 V, vec3 N, vec3 F0, MaterialData material) {
  vec3 H = normalize(V + L);

  // Cook-Torrance BRDF
  float NDF = DistributionGGX(N, H, material.roughness);
  float G = GeometrySmith(N, V, L, material.roughness);
  vec3 F = FresnelSchlick(max(dot(H, V), 0.0), F0);

  vec3 numerator = NDF * G * F;
  float denominator = 4.0 * max(dot(N, V), 0.0) * max(dot(N, L), 0.0) +
                      0.0001;  // + 0.0001 to prevent divide by zero
  vec3 brdf = numerator / denominator;

  // kS is equal to Fresnel
  vec3 kS = F;
  // for energy conservation, the diffuse and specular light can't
  // be above 1.0 (unless the surface emits light); to preserve this
  // relationship the diffuse component (kD) should equal 1.0 - kS.
  vec3 kD = vec3(1.0) - kS;
  // multiply kD by the inverse metalness such that only non-metals
  // have diffuse lighting, or a linear blend if partly metal (pure metals
  // have no diffuse light).
  kD *= 1.0 - material.metallic;

  // note that we already multiplied the BRDF by the Fresnel
  // (kS) so we won't multiply by kS again
  return (kD * material.albedo / PI + brdf);
}

void main() {
  // Build TBN
  vec3 N = normalize(normal);
  vec3 T = normalize(tangent);
  vec3 B = normalize(cross(N, T));
  mat3 TBN = mat3(T, B, N);

  uint mat_ind = draw_call.material_index;
  MaterialData material;

  if (draw_call.is_material) {
    material.albedo = materials.data[mat_ind].albedo;
    material.metallic = materials.data[mat_ind].metallic;
    material.roughness = materials.data[mat_ind].roughness;
  } else {
    material.albedo = texture(albedo_map, tex_coord).rgb;
    material.metallic = texture(metallic_map, tex_coord).r;
    material.roughness = texture(roughness_map, tex_coord).r;
    vec3 tangent_normal = texture(normal_map, tex_coord).xyz * 2.0 - 1.0;
    N = normalize(TBN * tangent_normal);
  }
  material.ao = materials.data[mat_ind].ao;

  vec3 V = normalize(scene_data.cam_pos - world_pos);

  // calculate reflectance at normal incidence; if dia-electric (like plastic)
  // use F0 of 0.04 and if it's a metal, use the albedo color as F0 (metallic
  // workflow)
  vec3 F0 = vec3(0.04);
  F0 = mix(F0, material.albedo, material.metallic);

  // reflectance equation
  vec3 Lo = vec3(0.0);

  // --- Point Lights ---
  for (int i = 0; i < 4; ++i) {
    // calculate per-light radiance
    vec3 L = normalize(lights.data[i].pos - world_pos);
    float distance = length(lights.data[i].pos - world_pos);
    float attenuation = 1.0 / (distance * distance);
    vec3 radiance = vec3(lights.data[i].power) * attenuation;

    // Calculate PBR contribution
    vec3 PBR = PBR_Contribution(L, V, N, F0, material);

    // scale light by NdotL
    float NdotL = max(dot(N, L), 0.0);

    // add to outgoing radiance Lo
    Lo += PBR * radiance * NdotL;
  }

  // --- Directional Light ---
  if (draw_call.dir_light) {
    // L_dir is the vector towards the light.
    vec3 L_dir = normalize(-scene_data.dir_light_direction);

    // Calculate PBR contribution
    vec3 PBR_dir = PBR_Contribution(L_dir, V, N, F0, material);
    float NdotL_dir = max(dot(N, L_dir), 0.0);

    // add to outgoing radiance Lo
    Lo += PBR_dir * scene_data.dir_light_radiance * NdotL_dir;
  }

  // --- Final Output ---
  // ambient lighting
  vec3 ambient = vec3(0.03) * material.albedo * material.ao;
  vec3 color = ambient + Lo;

  color = TonemapFilmic(color * scene_data.exposure, scene_data.white);

  frag_color = vec4(Linear2SRGB(color), 1.0);
}
