layout(set = 1, binding = 0, row_major, std140) uniform SceneData {
  mat4 view_projection;
  vec3 cam_pos;
  float white;
  vec3 light_dir;
  float exposure;
  vec3 light_radiance;
}
scene_data;

struct InstanceData {
  mat4 model;
};

layout(set = 1, binding = 2, row_major, std430) buffer
    restrict readonly Instances {
  InstanceData data[];
}
instances;

layout(location = 0) in vec3 in_position;
layout(location = 1) in vec3 in_normal;
layout(location = 2) in vec3 in_tangent;
layout(location = 3) in vec2 in_tex_coord;

layout(location = 0) out vec3 world_pos;
layout(location = 1) out vec3 normal;
layout(location = 2) out vec3 tangent;
layout(location = 3) out vec2 tex_coord;

void main() {
  const InstanceData instance_data = instances.data[gl_InstanceIndex];

  world_pos = vec3(vec4(in_position, 1.0) * instance_data.model);
  // Model matrix doesn't contain non-uniform scale.
  normal = in_normal * mat3(instance_data.model);
  tangent = in_tangent * mat3(instance_data.model);
  tex_coord = in_tex_coord;

  gl_Position = vec4(world_pos, 1.0) * scene_data.view_projection;
}
