layout(push_constant, std430) uniform DrawCall {
  uint instance_index;
  uint material_index;
} draw_call;

layout(set = 1, binding = 0, std140) uniform SceneData {
  mat4 view_projection;
  vec3 cam_pos;
} scene_data;

struct InstanceData {
  mat4 model;
};

layout(set = 1, binding = 2, std430) buffer restrict readonly Instances {
  InstanceData data[];
} instances;

layout(location = 0) in vec3 in_position;
layout(location = 1) in vec3 in_normal;
layout(location = 2) in vec2 in_tex_coord;

layout(location = 0) out vec3 world_pos;
layout(location = 1) out vec3 normal;
layout(location = 2) out vec2 tex_coord;

void main() {
	const InstanceData instance_data = instances.data[draw_call.instance_index];

  world_pos = vec3(instance_data.model * vec4(in_position, 1.0));
  // Model matrix doesn't contain non-uniform scale.
  normal = mat3(instance_data.model) * in_normal;
  tex_coord = in_tex_coord;

  gl_Position = scene_data.view_projection * vec4(world_pos, 1.0);
}
