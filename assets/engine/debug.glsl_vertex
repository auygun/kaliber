layout(push_constant, row_major, std430) uniform DrawCall {
  mat4 view_projection;
}
draw_call;

layout(location = 0) in vec3 in_position;
layout(location = 1) in vec4 in_color;

layout(location = 0) out vec4 color;

void main() {
  color = in_color;
  gl_Position = vec4(in_position, 1.0) * draw_call.view_projection;
}
