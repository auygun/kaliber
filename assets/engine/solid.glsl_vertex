layout(location = 0) in vec2 in_position;
layout(location = 1) in vec2 in_tex_coord_0;

layout(push_constant) uniform Params {
  vec2 scale;
  vec2 offset;
  vec2 rotation;
  mat4 projection;
  vec4 color;
} params;

void main() {
  // Simple 2d transform.
  vec2 position = in_position;
  position *= params.scale;
  position =
      vec2(position.x * params.rotation.y + position.y * params.rotation.x,
           position.y * params.rotation.y - position.x * params.rotation.x);
  position += params.offset;

  gl_Position = params.projection * vec4(position, 0.0, 1.0);
}
