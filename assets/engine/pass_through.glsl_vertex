#extension GL_EXT_mesh_shader : require

// IN(0) vec2 in_position;
// IN(1) vec2 in_tex_coord_0;

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 4, max_primitives = 2) out;

// Arrays of scalars are tightly packed with the layout std430 qualifier
struct VertexData {
  float position[2];
  float uv[2];
};

layout(set = 0, binding = 0, std430) restrict readonly buffer Ssbo1 {
  VertexData data[];
} ssbo1;

layout(set = 0, binding = 1, std430) restrict readonly buffer Ssbo2 {
  uint data[];
} indices;

UNIFORM_BEGIN
  UNIFORM_V(vec2 scale)
  UNIFORM_V(vec2 offset)
  UNIFORM_V(vec2 rotation)
  UNIFORM_V(vec2 tex_offset)
  UNIFORM_V(vec2 tex_scale)
  UNIFORM_V(mat4 projection)
  UNIFORM_F(vec4 color)
UNIFORM_END

OUT(0) vec2 tex_coord_0[];

vec2 GetPosition(uint index) {
  float pos[2] = ssbo1.data[index].position;
  return vec2(pos[0], pos[1]);
}

vec2 GetUV(uint index) {
  float uv[2] = ssbo1.data[index].uv;
  return vec2(uv[0], uv[1]);
}

void main() {
  SetMeshOutputsEXT(4, 2);

  for(uint i = gl_LocalInvocationIndex; i < 4; i += 1) {
    // Simple 2d transform.
    vec2 position = GetPosition(i);
    position *= PARAM(scale);
    position = vec2(position.x * PARAM(rotation).y + position.y * PARAM(rotation).x,
                    position.y * PARAM(rotation).y - position.x * PARAM(rotation).x);
    position += PARAM(offset);

    // gl_Position = PARAM(projection) * vec4(position, 0.0, 1.0);
    gl_MeshVerticesEXT[i].gl_Position = PARAM(projection) * vec4(position, 0.0, 1.0);

    tex_coord_0[i] = (GetUV(i) + PARAM(tex_offset)) * PARAM(tex_scale);
  }

  for(uint i = gl_LocalInvocationIndex; i < 2; i += 1) {
    // fetch indices
    uint index = i * 3u;
    uint index_0 = indices.data[index + 0u];
    uint index_1 = indices.data[index + 1u];
    uint index_2 = indices.data[index + 2u];

    // triangle indices
    gl_PrimitiveTriangleIndicesEXT[i] = uvec3(index_0, index_1, index_2);
  }
}
