layout(location = 0) in vec2 in_position;
layout(location = 1) in vec2 in_tex_coord_0;

// Arrays of scalars are tightly packed with the layout std430 qualifier
struct VertexData {
  float position[2];
  float uv[2];
};

layout(set = 0, binding = 0, std430) restrict readonly buffer Ssbo1 {
  VertexData data[];
} ssbo1;

layout(push_constant) uniform Params {
  vec2 scale;
  vec2 offset;
  vec2 rotation;
  vec2 tex_offset;
  vec2 tex_scale;
  mat4 projection;
  vec4 color;
} params;

layout(location = 0) out vec2 tex_coord_0;

vec2 GetPosition(int index) {
  return vec2(ssbo1.data[index].position[0], ssbo1.data[index].position[1]);
}

vec2 GetUV(int index) {
  return vec2(ssbo1.data[index].uv[0], ssbo1.data[index].uv[1]);
}

void main() {
  // Simple 2d transform.
  vec2 position = GetPosition(gl_VertexIndex);
  position *= params.scale;
  position =
      vec2(position.x * params.rotation.y + position.y * params.rotation.x,
           position.y * params.rotation.y - position.x * params.rotation.x);
  position += params.offset;

  tex_coord_0 = (GetUV(gl_VertexIndex) + params.tex_offset) * params.tex_scale;

  gl_Position = params.projection * vec4(position, 0.0, 1.0);
}
