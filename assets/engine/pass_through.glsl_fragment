layout(location = 0) in vec2 tex_coord_0;

layout(push_constant) uniform Params {
  vec2 scale;
  vec2 offset;
  vec2 rotation;
  vec2 tex_offset;
  vec2 tex_scale;
  mat4 projection;
  vec4 color;
} params;

layout(set = 2, binding = 0) uniform sampler2D texture_0;

layout(location = 0) out vec4 frag_color;

void main() {
  frag_color = texture(texture_0, tex_coord_0) * params.color;
}
