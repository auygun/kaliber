config("vma_public") {
  include_dirs = [ "vma/include" ]

  defines = [
    "VMA_STATIC_VULKAN_FUNCTIONS=1",
    "USE_VOLK",
  ]

  if (target_os != "win") {
    cflags = [ "-Wno-nullability-completeness" ]
  }
}

source_set("vma") {
  configs -= [ "//build:warnings" ]
  public_configs = [ ":vma_public" ]

  sources = [
    "vk_mem_alloc.cpp",
  ]

  public_deps = [ "//src/third_party/volk" ]
}
