  if (target_os == "linux") {
    sources += [ "glslang/glslang/OSDependent/Unix/ossource.cpp" ]
  } else if (target_os == "win") {
    sources += [ "glslang/glslang/OSDependent/Windows/ossource.cpp" ]
  } else if (target_os == "android") {
    sources += [ "glslang/glslang/OSDependent/Unix/ossource.cpp" ]
