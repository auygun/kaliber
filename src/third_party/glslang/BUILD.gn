action("build_info") {
  script = "glslang/build_info.py"
  sources = [
    "glslang/CHANGES.md",
    "glslang/build_info.h.tmpl",
  ]
  args = [
    rebase_path("glslang", root_build_dir),
    "-i",
    rebase_path("glslang/build_info.h.tmpl", root_build_dir),
    "-o",
    rebase_path("$target_gen_dir/glslang/build_info.h", root_build_dir),
  ]
  outputs = [ "$target_gen_dir/glslang/build_info.h" ]
}

config("glslang_public") {
  include_dirs = [
    "$target_gen_dir",
    "glslang",
  ]

  cflags = []

  if (target_os == "win") {
    cflags += [
      "/wd4464",  # relative include path contains '..'
    ]
  } else {
    cflags += [
      "-fno-finite-math-only",
    ]
  }
}

